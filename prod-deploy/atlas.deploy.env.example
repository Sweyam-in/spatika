# Local deployment settings for Atlas VM. Copy to atlas.deploy.env (gitignored).
ATLAS_HOST=replace-with-atlas-vm-ip-or-hostname
ATLAS_USER=deploy
ATLAS_SSH_PORT=22
# Optional SSH key; leave empty to use ssh-agent or ~/.ssh/id_rsa
ATLAS_SSH_KEY=
ATLAS_REMOTE_DIR=/opt/spatika/app

# Local production secrets/settings file copied to the VM with mode 0600.
SPATIKA_PRODUCTION_ENV=.env.production
