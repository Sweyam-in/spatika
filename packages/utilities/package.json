{
  "name": "@spatika/utilities",
  "version": "2.5.0",
  "license": "MIT",
  "description": "Spatika UI — on-demand utility class compiler driven by Spatika tokens. Vite and PostCSS plugins; no Tailwind required.",
  "homepage": "https://spatika.sweyam.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sweyam-in/spatika.git",
    "directory": "packages/utilities"
  },
  "bugs": {
    "url": "https://github.com/Sweyam-in/spatika/issues"
  },
  "author": "Sreelal Chalil",
  "keywords": [
    "spatika",
    "utilities",
    "css",
    "design-tokens",
    "vite-plugin",
    "postcss-plugin"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "default": "./dist/vite.js"
    },
    "./postcss": {
      "types": "./dist/postcss.d.ts",
      "import": "./dist/postcss.js",
      "require": "./postcss.cjs",
      "default": "./dist/postcss.js"
    },
    "./preflight.css": "./src/preflight.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "postcss.cjs",
    "src/preflight.css",
    "README.md",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && node ../../scripts/fix-esm-extensions.mjs dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "postcss": "^8.4.0",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "postcss": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
